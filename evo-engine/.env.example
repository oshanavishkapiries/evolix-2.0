# Every setting in app/core/config.py is listed here; tests/test_env_sync.py checks parity.

# Required (bootstrap)
# The app authenticates this engine with its own per-engine token. Generate one with:
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
EVO_SECRET_TOKEN=
# Engine identity; empty uses the host name in error reports.
ENGINE_NAME=
# Docker Compose publication (not read by the Python Settings object).
EVO_BIND_ADDRESS=127.0.0.1
EVO_PORT=8000
# Initial app callback address, needed to report to the app before the first push.
# Also push-managed: a later push may override this bootstrap fallback.
EVO_WEBHOOK_URL=https://your-app.example/api/evo/complete

# Optional fallback
# Managed settings can be changed in admin config: DB > .env > built-in default.
# The app pushes its merged global/per-engine values; absent keys use these .env defaults.
# These entries may be deleted from .env once stored in the DB.
# On the very first app deployment, login-critical app keys must remain in the app's
# .env until saved in its DB; this engine has no login credentials of its own.

# Required for uploads; kept encrypted in the app DB and engine SQLite push cache.
# PIXELDRAIN_API_KEY=
# Empty derives https://<webhook host>/api/errors.
# ERROR_REPORT_URL=

# Resource limits; CLEAN_ORPHANS_ON_START requires a manual restart after a push.
# MAX_CONCURRENT_EXTRACTIONS=2
# MAX_CONCURRENT_DOWNLOADS=2
# MAX_QUEUED_TASKS=50
# MIN_FREE_DISK_GB=10
# CLEAN_ORPHANS_ON_START=false

# Extraction performance. Pool size and recycle limits apply live.
# BROWSER_POOL_SIZE=2
# BROWSER_MAX_USES=25
# BROWSER_RECYCLE_RSS_MB=1500
# BLOCK_ASSETS=1
# EXTRACTION_REUSE_TTL_S=300
# PROVIDER_FAIL_THRESHOLD=3
# PROVIDER_FAIL_WINDOW_S=600
# PROVIDER_COOLDOWN_S=300
# PROVIDER_MISS_THRESHOLD=10
# EXTRACTOR_ORDER=cinesrc,ythd
# YTHD_DECRYPTOR_CACHE=1

# Optional Sinhala translation; empty key disables it. Budget 0 = unlimited.
# OPENROUTER_API_KEY=
# TRANSLATE_MODEL=google/gemini-3.1-flash-lite
# TRANSLATE_CHUNK_CUES=50
# TRANSLATE_CONTEXT_CUES=4
# TRANSLATE_CONCURRENCY=4
# TRANSLATE_DAILY_BUDGET_USD=0

# Local storage paths remain environment-only deployment settings, not push-managed.
# Defaults live next to the engine; Docker Compose supplies the volume locations.
# DOWNLOAD_DIR=
# TEMP_DIR=
# SQLITE_DB_PATH=
