# Every setting the engine reads (app/core/config.py). tests/test_env_sync.py fails if this file and the code drift apart.
# Only the first block is required; everything else shows its default.

# Generate a token with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Use the same EVO_SECRET_TOKEN in the Next.js application.
EVO_SECRET_TOKEN=

# Required for uploading cached media and subtitles.
PIXELDRAIN_API_KEY=

# Public Next.js callback URL; leave empty to disable completion notifications.
# Container localhost refers to the engine container itself.
EVO_WEBHOOK_URL=https://your-app.example/api/evo/complete
# Errors go to the app's error tracker (admin > Errors). Empty = https://<webhook host>/api/errors.
ERROR_REPORT_URL=
# Name shown on reported errors; empty = host name.
ENGINE_NAME=

# Docker Compose only (not read by the engine): where the container is published.
# Compose publishes to localhost by default. Set 0.0.0.0 for remote access.
EVO_BIND_ADDRESS=127.0.0.1
EVO_PORT=8000

# Resource limits
MAX_CONCURRENT_EXTRACTIONS=2
MAX_CONCURRENT_DOWNLOADS=2
MAX_QUEUED_TASKS=50
MIN_FREE_DISK_GB=10
CLEAN_ORPHANS_ON_START=true

# Extraction performance (also editable live under /admin/evo/engines/<id>)
BROWSER_POOL_SIZE=2
BROWSER_MAX_USES=25
BROWSER_RECYCLE_RSS_MB=1500
BLOCK_ASSETS=1
EXTRACTION_REUSE_TTL_S=300
PROVIDER_FAIL_THRESHOLD=3
PROVIDER_FAIL_WINDOW_S=600
PROVIDER_COOLDOWN_S=300
EXTRACTOR_ORDER=cinesrc,ythd
YTHD_DECRYPTOR_CACHE=1

# Optional Sinhala subtitle translation; disabled without an API key.
OPENROUTER_API_KEY=
TRANSLATE_MODEL=google/gemini-3.1-flash-lite
TRANSLATE_CHUNK_CUES=50
TRANSLATE_CONTEXT_CUES=4
TRANSLATE_CONCURRENCY=4
TRANSLATE_DAILY_BUDGET_USD=0

# Storage paths. Defaults live next to the engine; Docker Compose sets them to the container volumes.
# DOWNLOAD_DIR=
# TEMP_DIR=
# SQLITE_DB_PATH=
