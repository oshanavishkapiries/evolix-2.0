# Bootstrap only. All other settings (limits, extraction, translation, PIXELDRAIN_API_KEY,
# ERROR_REPORT_URL, ...) are pushed from the app's Admin > Settings > Configuration.
# Precedence once pushed: app DB > this file > built-in default (see app/core/config.py).

# The app authenticates this engine with its own per-engine token. Generate one with:
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# It also derives the key that decrypts pushed secrets, so keep it stable.
EVO_SECRET_TOKEN=
# App callback address, needed to report to the app before the first push.
EVO_WEBHOOK_URL=https://your-app.example/api/evo/complete
