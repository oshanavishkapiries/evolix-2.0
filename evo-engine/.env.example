# Evo Engine configuration reference. Copy to .env beside this file.
# Admin > Settings > Configuration manages global and per-engine DB overrides.
# The app pushes those settings to the engine, which caches them in SQLite.
# Precedence: pushed configuration > .env > built-in default.
# .env supplies startup/fallback values; it is not the source of truth once managed.

# Deployment-only: shared authentication/encryption token. Keep stable and match
# the token registered for this engine in the app. Generate: openssl rand -base64 32.
EVO_SECRET_TOKEN=""
# Optional error-reporting name; empty uses the hostname.
ENGINE_NAME=""
# Optional native paths. If omitted, default to downloads/, temp/ and
# data/evo_engine.sqlite3 under evo-engine/. Compose supplies its own paths.
# DOWNLOAD_DIR=./downloads
# TEMP_DIR=./temp
# SQLITE_DB_PATH=./data/evo_engine.sqlite3
# Docker Compose binding only; not runtime/admin settings.
EVO_BIND_ADDRESS=127.0.0.1
EVO_PORT=8000

# Admin-managed callbacks. Empty completion URL disables callbacks; empty error
# URL derives /api/errors from the completion URL. Use your reachable app address.
EVO_WEBHOOK_URL=""
ERROR_REPORT_URL=""

# Admin-managed integrations. Required for CDN uploads and AI translation,
# respectively. The app's analytics key does not automatically set this key.
PIXELDRAIN_API_KEY=""
OPENROUTER_API_KEY=""

# Admin-managed processing limits.
MAX_CONCURRENT_EXTRACTIONS=2
MAX_CONCURRENT_DOWNLOADS=2
MAX_QUEUED_TASKS=50
MIN_FREE_DISK_GB=10
# This admin setting takes effect on the next engine restart.
CLEAN_ORPHANS_ON_START=false

# Admin-managed browser and extraction settings.
BROWSER_POOL_SIZE=2
BROWSER_MAX_USES=25
BROWSER_RECYCLE_RSS_MB=1500
BLOCK_ASSETS=1
EXTRACTION_REUSE_TTL_S=300
PROVIDER_FAIL_THRESHOLD=3
PROVIDER_FAIL_WINDOW_S=600
PROVIDER_COOLDOWN_S=300
PROVIDER_MISS_THRESHOLD=10
EXTRACTOR_ORDER=cinesrc,ythd
YTHD_DECRYPTOR_CACHE=1

# Admin-managed translation settings (new jobs use updated values).
TRANSLATE_MODEL=google/gemini-3.1-flash-lite
TRANSLATE_CHUNK_CUES=50
TRANSLATE_CONTEXT_CUES=4
TRANSLATE_CONCURRENCY=4
# 0 disables the engine's daily budget cap; OpenRouter key limits still apply.
TRANSLATE_DAILY_BUDGET_USD=0

# Admin-managed storage. Local uses separate LRU pools (25 GB total by default).
# Docker volumes have no size cap; the engine enforces these quotas.
# MIN_FREE_DISK_GB also applies to local uploads.
CDN_PROVIDER=pixeldrain
# LOCAL_CDN_DIR=./cdn
LOCAL_CDN_VIDEO_GB=20
LOCAL_CDN_SUBTITLE_GB=5
