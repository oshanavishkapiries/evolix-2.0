# Bootstrap only. Everything else (TTLs, engines, error alerts, OpenRouter, stream
# base, ...) is configured in Admin > Settings > Configuration and stored in the DB.

# Database (Neon Postgres connection string). Cannot be managed in the DB.
DATABASE_URL=""
# Encrypts secrets stored in the DB (generate: openssl rand -base64 32; also accepts 64 hex characters).
CONFIG_ENCRYPTION_KEY=""

# Needed on the very first deploy so an administrator can log in (OTP mail + session
# tokens) and open the admin panel. Once saved there, they may be removed from .env.
ADMIN_EMAILS=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
# The config loader validates all required settings, so TMDB must be present initially.
TMDB_API_KEY=""
