# Main application configuration reference. Copy to .env and fill required values.
# Admin > Settings > Configuration saves overrides in the database.
# Precedence for admin-managed settings: database > .env > built-in default.
# Editing .env requires restarting the app; admin changes apply at runtime.

# Bootstrap: required, deployment-only; cannot be changed in the admin panel.
DATABASE_URL=""
# Generate: openssl rand -base64 32 (or use 64 hex characters).
# Keep stable: changing it makes existing encrypted DB secrets unreadable.
CONFIG_ENCRYPTION_KEY=""

# Admin-managed settings below are environment fallbacks, not the source of truth.
# Required on a fresh database: mail, JWT secrets, and TMDB credentials.
# ADMIN_EMAILS grants access to the first admin (register and verify that email).
ADMIN_EMAILS=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# Generate each independently: openssl rand -base64 48 (minimum 32 characters).
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
TMDB_API_KEY=""

# Authentication defaults (admin-managed).
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=604800
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
DEV_LOG_OTP=false

# Engines and playback (admin-managed). Per-engine registrations/tokens in the DB
# replace this fallback engine list once managed engines exist.
EVO_ENGINES='["http://127.0.0.1:8000"]'
EVO_SECRET_TOKEN=""
# Empty uses the built-in stream proxy.
STREAM_BASE=""
# App analytics key; configure the engine's translation key separately.
OPENROUTER_API_KEY=""

# Error alerts (admin-managed). Empty recipients use ADMIN_EMAILS.
APP_URL=""
ERROR_ALERT_EMAILS=""
ERROR_ALERT_EMAIL=on
ERROR_ALERT_WEBHOOK=""

# Deployment/build-only settings; not editable in the admin panel.
# Optional: installation gate; leave empty to disable.
NEXT_PUBLIC_PWA_GATE=""
# Optional override; when empty the build uses the Git commit automatically.
NEXT_PUBLIC_RELEASE=""
# Local database proxy only. Leave commented for the standard local setup.
# LOCAL_NEON_PROXY_PORT=4444
# NEON_PROXY_URL=http://127.0.0.1:4444/sql
