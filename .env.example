# Database (Neon Postgres connection string)
DATABASE_URL=""

# SMTP (Brevo)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Auth: JWT signing secrets (generate each with: openssl rand -base64 48)
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Auth lifetimes and OTP policy
ACCESS_TOKEN_TTL_SECONDS="3600"
REFRESH_TOKEN_TTL_SECONDS="604800"
OTP_TTL_SECONDS="600"
OTP_RESEND_COOLDOWN_SECONDS="60"
OTP_MAX_ATTEMPTS="5"

# Dev only: log OTPs to the server console (ignored in production)
DEV_LOG_OTP="false"

# TMDB (v3 API key from themoviedb.org)
TMDB_API_KEY=""

# Admin access: comma-separated emails allowed to use /admin
ADMIN_EMAILS=""

# Set to "off" to disable the forced-install screen on phones and tablets
NEXT_PUBLIC_PWA_GATE=""

# Evo engine reports finished CDN caches here (the app's /api/evo/complete). Engine-side setting: point it at
# the deployment whose database should receive the sources (local dev: http://127.0.0.1:3000/..., production: https://<your-app>/...).
EVO_WEBHOOK_URL="http://127.0.0.1:3000/api/evo/complete"

# Sinhala subtitle translation (OpenRouter)
OPENROUTER_API_KEY=""
