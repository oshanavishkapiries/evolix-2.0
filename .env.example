# Every variable the app reads (lib/env.ts, plus NEXT_PUBLIC_PWA_GATE and drizzle.config.ts). tests/env-sync.test.ts fails if this file and the code drift apart.

# Database (Neon Postgres connection string)
DATABASE_URL=""

# SMTP (Brevo)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Auth: JWT signing secrets (generate each with: openssl rand -base64 48)
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Auth lifetimes and OTP policy
ACCESS_TOKEN_TTL_SECONDS="3600"
REFRESH_TOKEN_TTL_SECONDS="604800"
OTP_TTL_SECONDS="600"
OTP_RESEND_COOLDOWN_SECONDS="60"
OTP_MAX_ATTEMPTS="5"

# Dev only: log OTPs to the server console (ignored in production)
DEV_LOG_OTP="false"

# TMDB (v3 API key from themoviedb.org)
TMDB_API_KEY=""

# Admin access: comma-separated emails allowed to use /admin
ADMIN_EMAILS=""

# Set to "off" to disable the forced-install screen on phones and tablets
NEXT_PUBLIC_PWA_GATE=""

# Evo engines: JSON array of URLs or {"url","name"} objects; one entry is a single-engine setup.
# Read at start; restart or redeploy after changing it. The engines' own settings live in evo-engine/.env.example.
EVO_ENGINES='["http://127.0.0.1:8000"]'
# e.g. several: EVO_ENGINES='["http://10.0.0.1:8000", {"url": "http://10.0.0.2:8000", "name": "Frankfurt"}]'

# Shared by every engine; must equal EVO_SECRET_TOKEN in each engine's .env.
EVO_SECRET_TOKEN=""
# Optional. Address of the Cloudflare stream Worker (tools/stream-worker/README.md); empty = play through this app.
STREAM_BASE=""

# Optional: OpenRouter analytics on the admin overview (management key, "sk-or-v1-...").
OPENROUTER_API_KEY=""

# Error tracking (admin > Errors). Alerts go out for new issues and regressions.
APP_URL=""                 # public base URL, used for links in alerts, e.g. https://evolix.example
ERROR_ALERT_EMAILS=""      # comma separated; empty = ADMIN_EMAILS
ERROR_ALERT_EMAIL="on"     # "off" disables alert emails
ERROR_ALERT_WEBHOOK=""     # optional Discord/Slack incoming webhook URL
# NEXT_PUBLIC_RELEASE=""   # release tag on error events; next.config sets it from the git commit at build time
