{
  "name": "evolix-2",
  "version": "1.7.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:env": "tsx tests/env-sync.ts && (cd evo-engine && test/.venv/bin/python -m unittest tests.test_env_sync)",
    "evo:start": "pm2 start tools/evo-engine/ecosystem.config.cjs",
    "evo:stop": "pm2 stop evo-engine",
    "evo:restart": "pm2 restart evo-engine",
    "evo:status": "pm2 status evo-engine",
    "evo:logs": "pm2 logs evo-engine",
    "test:subtitles": "vitest run --config tests/subtitles/vitest.config.ts",
    "test:subtitles:engine": "evo-engine/test/.venv/bin/python tests/subtitles/run_engine.py",
    "test:subtitles:e2e": "playwright test --config tests/subtitles/playwright.config.ts",
    "test:problems": "vitest run --config tests/problems/vitest.config.ts",
    "test:journeys": "vitest run --config tests/journeys/vitest.config.ts",
    "test:feedback": "vitest run --config tests/feedback/vitest.config.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vidstack/react": "^1.15.7",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.4",
    "hls.js": "^1.7.3",
    "jose": "^6.2.12",
    "next": "16.4.3",
    "nodemailer": "^10.0.16",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "source-map-js": "1.2.2",
    "vidstack": "^1.15.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.10.1"
}
